  dialogueText: {fileID: 1538231296}
  dialogueLines:
  - "\xBFQu\xE9 traes, Moshi?... \xBFuna... carta?"
  - "Lee en voz baja: 'Claudia, siento no haberte dicho antes lo que siento... \u2014
    Javier'."
  - "No sab\xEDa que Javier pensaba esto... Tal vez debimos hablar antes."
  - "Gracias, Moshi. Necesito verlo. Quiz\xE1s todo pueda arreglarse."
  secondaryDialogueLines: []
