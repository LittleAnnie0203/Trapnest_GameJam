  npcName: Laura
  dialoguePanel: {fileID: 814444734}
  dialogueText: {fileID: 1538231296}
  dialogueLines:
  - "Moshi... \xBFesa es nuestra manilla?"
  - "No pens\xE9 volver a verla. Betty y yo la hicimos juntas..."
  - "Pero desde aquella discusi\xF3n, no hemos vuelto a hablar"
  - "Tal vez... fue mi culpa tambi\xE9n. Dile a Betty que lo siento, \xBFs\xED?"
  secondaryDialogueLines: []
