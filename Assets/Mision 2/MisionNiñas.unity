  m_Name: 
  m_EditorClassIdentifier: 
  missionManager: {fileID: 0}
  missionManagerM3: {fileID: 0}
  missionManagerM4: {fileID: 664644223}
  npcName: Madre
  dialoguePanel: {fileID: 814444734}
  dialogueText: {fileID: 1538231296}
  dialogueLines:
  - "\xBFHas visto a mi hijo? Tiene 6 a\xF1os y se llama Tom\xE1s."
  - "Por favor, \xBFpuedes ayudarme a encontrarlo? Estoy muy preocupada."
  secondaryDialogueLines:
  - "\xA1Tom\xE1s! Gracias por traerlo de vuelta."
  - "No s\xE9 c\xF3mo agradecerte, Moshi."
  - "Finalmente est\xE1 a salvo y tiene su osito. Gracias."
