  m_Name: 
  m_EditorClassIdentifier: 
  missionManager: {fileID: 0}
  missionManagerM3: {fileID: 0}
  missionManagerM4: {fileID: 0}
  missionManagerFinal: {fileID: 308230549}
  npcName: Yaffy
  dialoguePanel: {fileID: 814444734}
  dialogueText: {fileID: 1538231296}
  dialogueLines:
  - "Extra\xF1o tanto a Mochi... era mi mejor amigo"
  - "A veces creo que a\xFAn oigo su collar tintinear"
  - "Si alg\xFAn d\xEDa lo encuentras, Moshi... tr\xE1emelo, por favor"
  secondaryDialogueLines:
  - Ese... ese es su collar... Mochi
  - Gracias, Moshi... me has devuelto la paz
  - "Desde hoy, t\xFA ser\xE1s mi nuevo compa\xF1ero"
